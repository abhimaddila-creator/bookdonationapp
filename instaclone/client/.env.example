# Firebase web app config (from Firebase Console -> Project Settings -> Your apps)
# These values are PUBLIC identifiers - they are not secrets.
# Copy this file to .env and fill in YOUR values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Instagram login (optional): the Instagram App ID from Meta for Developers.
# Leave empty to hide the "Continue with Instagram" button.
VITE_IG_APP_ID=